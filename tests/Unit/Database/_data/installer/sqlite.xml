<?xml version="1.0" encoding="UTF-8"?>
<schema>
    <meta>
        <drivers>
            <driver>sqlite</driver>
        </drivers>
    </meta>
    <sql>
        <action table="#__test_items">
            <condition type="missing" />
            <query>CREATE TABLE #__test_items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                body TEXT,
                created_at TEXT DEFAULT NULL
            )</query>
        </action>
        <action table="#__test_items">
            <condition type="missing" value="created_at" />
            <query canfail="true">ALTER TABLE #__test_items ADD COLUMN created_at TEXT DEFAULT NULL</query>
        </action>
    </sql>
</schema>
